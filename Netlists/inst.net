* Tube Channel stage netlist: inst (generated by tools/split_netlist.py)
.param GAINPOT=2k   ; VR1B mic GAIN rheostat 0..10k (0 = max, 40.6 dB)
.param IMP=10k      ; VR12 IMPEDANCE: each gang 0..10k (gangs in parallel)
.param PH48=0       ; SW2 phantom: 0 off, 1 on (+45 V)
.param LOCUT=10k    ; VR2 LOW CUT rheostat 0..10k (10k = 11 Hz, 0 = 249 Hz)
.param TUBE20=0     ; SW1 tube GAIN: 0 Norm (x1), 1 +20dB (x11)
.param HV=1         ; SW4 plate voltage: 1 HIGH (~148 V), 0 NORMAL (~44 V)
.param INVERT=0     ; SW3 phase
.param PREOUT=0.7   ; VR3 PREAMP OUTPUT wiper 0..1 (20k B, linear)
.param COMP=1       ; SW7: 1 Active, 0 Bypass
.param VTRIM=0.5    ; VR13 Vactrol Cal. 0..1 of 25k
.param THR=0.5      ; VR4 THRESHOLD wiper 0..1 (CCW end = A6B output)
.param RATIO=0.5    ; VR5 RATIO 0..1 (2:1 .. 100:1)
.param TATT=10m     ; attack time constant (d): 4.9 ms .. 225 ms
.param TREL=200m    ; release time constant (d): 94 ms .. 314 ms
.param CMPOUT=0.6   ; VR6 COMP OUTPUT wiper 0..1 (20k, 15A log - set as fraction of track)
.param EQON=1       ; SW14: 1 Active, 0 Bypass
.param LOW=0.5      ; VR7 LOW 0..1 (0.5 = flat)
.param LOSH=1       ; SW8 Lo-SHIFT: 1 = 40 Hz (C37/C39 in), 0 = 120 Hz
.param HIGH=0.5     ; VR11 HIGH 0..1 (0.5 = flat)
.param HISH=0       ; SW13 Hi-SHIFT: 1 = 6 kHz (C59 in), 0 = 18 kHz
.param HMID=0.5     ; Hi-MID level 0..1 (0.5 = flat; 1 = boost)
.param HMF=0.5      ; Hi-MID FREQ 0..1 (VR16A/B together, 0..100k)
.param HMLO=1       ; Hi-MID range: 1 = 200 Hz-2 kHz, 0 = x10
.param HMNAR=1      ; Hi-MID Q: 1 = A8B gain 1.221, 0 = 1.0
.param LMID=0.5     ; Lo-MID level 0..1
.param LMF=0.5      ; Lo-MID FREQ 0..1
.param LMLO=1       ; Lo-MID range: 1 = 20-200 Hz, 0 = x10
.param LMNAR=1      ; Lo-MID Q
.param MASTER=0.8   ; VR10 MASTER wiper 0..1
.param SMALL=1m BIG=1e9
.param INST=0
.param ZINST=10k
.param G5532=12Meg S5532=9
.param G2134=8Meg  S2134=20
.param G07x=5.25Meg S07x=20

.model 2SA970 PNP(IS=3e-14 BF=500 VAF=100 RB=30 IKF=0.05 CJC=4p CJE=20p TF=1.4n BVCEO=120)
.model 2N4403 PNP(IS=6.5e-14 BF=150 VAF=70 IKF=0.3 RB=10 CJC=8.5p CJE=30p TF=0.8n BVCEO=40)
.model 2N4401 NPN(IS=2.6e-14 BF=150 VAF=90 IKF=0.3 RB=10 CJC=6.5p CJE=30p TF=0.64n BVCEO=40)
.model BF423  PNP(IS=2e-14 BF=80 VAF=150 RB=20 CJC=1.6p CJE=10p TF=2.6n BVCEO=250)
.model BF422  NPN(IS=2e-14 BF=80 VAF=150 RB=20 CJC=1.6p CJE=10p TF=2.6n BVCEO=250)
.model MPSA29Q NPN(IS=1e-14 BF=100 VAF=100 RB=10 CJC=8p CJE=20p TF=1.3n)

C10  O1S JT  10u
R225 JT  0   5.1Meg
C6   JT  nU1 2.2u
R224 nU1 0   1Meg
R223 nU1 P13 4.99k
C85  P13 0   100p
XA13A P13 N13 O13 OPAMP params: GBW={G2134} SR={S2134}
R220 O13 N13 4.99k
R52  N13 nC21 100
C21  nC21 IW 220u
R15  IW  0   1Meg
C8   O13 LC  0.68u
C11  O13 LC  0.68u
R31  LC  nLC 470
RVR2 nLC 0   {LOCUT+SMALL}
XA13B LC O13B O13B OPAMP params: GBW={G2134} SR={S2134}
RVR1A IW 0 {if(INST>0,GAINPOT+SMALL,BIG)}
* mic path: normalled through the front jack; instrument plug breaks it and drives the tip directly
RMICSW O1 O1S {if(INST>0,BIG,SMALL)}
RINST ISRC JT {if(INST>0,ZINST,BIG)}
